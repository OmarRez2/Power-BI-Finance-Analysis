table _Measures
	lineageTag: 82a52953-690c-4c18-b481-f17bdea4e3fc

	measure 'Finance Analysis Title' = "Finance Analysis"
		displayFolder: 06 Titles
		lineageTag: 1dd24151-f32a-4eee-8945-a4deb87877d3

	measure 'Total Amount' = SUM(finance_transactions[amount])
		formatString: "₹"\ #,0.00;#,0.00\ -"₹";"₹"\ #,0.00
		displayFolder: 01 Amount
		lineageTag: c7f76598-6b67-4063-bafd-c15182bd7eaf

		annotation PBI_FormatHint = {"currencyCulture":"en-IN"}

	measure 'PY Amount' = CALCULATE([Total Amount] , SAMEPERIODLASTYEAR('Calendar Date'[Date]))
		displayFolder: 01 Amount
		lineageTag: 0756e2b7-44b1-4f2b-ab35-863bad081bee

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'YOY Amount' = [Total Amount] - [PY Amount]
		displayFolder: 01 Amount
		lineageTag: e5bba883-2703-4da1-b5d6-837b353539c4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'YOY % Amount' = DIVIDE([YOY Amount] , [PY Amount],0)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 01 Amount
		lineageTag: cfaf228d-446d-4a03-bb16-8bd54d408050

	measure 'Total Transactions' = DISTINCTCOUNT(finance_transactions[transaction_id])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: 02 Transactions
		lineageTag: bacb95c8-f0fd-4798-be31-32c66cc9bbca

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'PY Transaction' = CALCULATE([Total Transactions],SAMEPERIODLASTYEAR('Calendar Date'[Date]))
		formatString: 0
		displayFolder: 02 Transactions
		lineageTag: dc6cdeb5-a257-4d83-84a0-fef71a156091

	measure 'YOY Transaction' = [Total Transactions] - [PY Transaction]
		formatString: 0
		displayFolder: 02 Transactions
		lineageTag: 697ea1e4-4059-49d7-b3a5-ef1c79223fa9

	measure 'YOY % Transaction' = DIVIDE([YOY Transaction],[PY Transaction],0)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 02 Transactions
		lineageTag: 36c1bbd5-1f48-4206-98a4-59bd5ba199e8

	measure 'AVG Transaction Value' = AVERAGE(finance_transactions[amount])
		formatString: "₹"\ #,0.00;#,0.00\ -"₹";"₹"\ #,0.00
		displayFolder: 03 Avg Transaction Value
		lineageTag: ff3a869d-13da-4bdc-a864-930245ad2a2c

		annotation PBI_FormatHint = {"currencyCulture":"en-IN"}

	measure 'PY AVG Transaction' = CALCULATE([AVG Transaction Value],SAMEPERIODLASTYEAR('Calendar Date'[Date]))
		displayFolder: 03 Avg Transaction Value
		lineageTag: 5ecc5566-438a-41b9-8221-5f90a74ab35a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'YOY AVG Transaction' = [AVG Transaction Value] - [PY AVG Transaction]
		displayFolder: 03 Avg Transaction Value
		lineageTag: 0088e86f-cd70-411d-bf4e-754989cca493

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'YOY % AVG Transaction' = DIVIDE([YOY AVG Transaction],[PY AVG Transaction],0)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 03 Avg Transaction Value
		lineageTag: 5e91d752-eeb6-4b3f-bf84-1d1e6ab08d4a

	measure 'Total Fees' = SUM(finance_transactions[fee_amount])
		formatString: "₹"\ #,0.00;#,0.00\ -"₹";"₹"\ #,0.00
		displayFolder: 04 Fees
		lineageTag: f0e1f937-7188-4d90-98f0-816a46aedd3f

		annotation PBI_FormatHint = {"currencyCulture":"en-IN"}

	measure 'PY Fees' = CALCULATE([Total Fees],SAMEPERIODLASTYEAR('Calendar Date'[Date]))
		displayFolder: 04 Fees
		lineageTag: b479274e-3b64-4b11-82eb-f13c83aefed4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'YOY Fees' = [Total Fees] - [PY Fees]
		displayFolder: 04 Fees
		lineageTag: 9f07b4d7-d679-4052-9ba1-ce7970eb6070

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'YOY % Fees' = DIVIDE([YOY Fees] , [PY Fees],0)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 04 Fees
		lineageTag: 85f119fa-1cfb-436d-b1ef-8c951fff49f8

	measure 'Total Tax' = SUM(finance_transactions[tax_amount])
		formatString: "₹"\ #,0.00;#,0.00\ -"₹";"₹"\ #,0.00
		displayFolder: 05 Tax
		lineageTag: 2797c6ed-09e9-40d9-90a5-fa9dd8757f05

		annotation PBI_FormatHint = {"currencyCulture":"en-IN"}

	measure 'PY Tax' = CALCULATE([Total Tax] , SAMEPERIODLASTYEAR('Calendar Date'[Date]))
		displayFolder: 05 Tax
		lineageTag: 3f581400-daf1-4a78-87f7-c1766281fb43

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'YOY Tax' = [Total Tax] - [PY Tax]
		displayFolder: 05 Tax
		lineageTag: 38182f23-1d42-4b44-9f09-13ef702c8a13

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'YOY % Tax' = DIVIDE([YOY Tax],[PY Tax],0)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 05 Tax
		lineageTag: 9bff0a5a-4c36-4a00-a3b2-d8baf1198fb5

